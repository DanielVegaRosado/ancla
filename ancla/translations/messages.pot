#: ancla/ai/anthropic.py:55
#, python-format
msgid ""
"Ve a Ajustes y rellena la clave y el modelo de Anthropic: hacen falta los"
" dos. La clave se genera en %(url)s, y Anthropic cobra por uso, así que "
"la cuenta necesita saldo antes de la primera propuesta."
msgstr ""

#: ancla/ai/anthropic.py:65
msgid "Vuelve a generar la propuesta: Anthropic ha devuelto una respuesta vacía."
msgstr ""

#: ancla/ai/anthropic.py:87
msgid ""
"Revisa el texto de la vacante o del CV y vuelve a intentarlo: Anthropic "
"ha rechazado esta petición por motivos de seguridad."
msgstr ""

