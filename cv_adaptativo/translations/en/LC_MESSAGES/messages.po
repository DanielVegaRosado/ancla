#: cv_adaptativo/archivo/repositorio.py:73 cv_adaptativo/perfil/almacen.py:162
#, python-format
msgid "No se pudo leer «%(nombre)s»: %(detalle)s."
msgstr "Could not read “%(nombre)s”: %(detalle)s."

#: cv_adaptativo/archivo/repositorio.py:123
#, python-format
msgid "No existe el archivo «%(archivo)s»."
msgstr "The file “%(archivo)s” does not exist."

#: cv_adaptativo/archivo/repositorio.py:133
#, python-format
msgid "No se pudo guardar el adjunto «%(nombre)s»: %(detalle)s."
msgstr "Could not save the attachment “%(nombre)s”: %(detalle)s."

#: cv_adaptativo/archivo/repositorio.py:186
#, python-format
msgid "El identificador «%(id)s» no es válido para un CV guardado."
msgstr "“%(id)s” is not a valid ID for a saved CV."

#: cv_adaptativo/archivo/serializacion.py:120
#, python-format
msgid ""
"El CV «%(id)s» no tiene una fecha válida (esperaba algo como 2026-07-24)."
msgstr ""
"The CV “%(id)s” does not have a valid date (expected something like "
"2026-07-24)."

#: cv_adaptativo/ia/anthropic.py:50
#, python-format
msgid ""
"Todavía no has configurado tu clave y tu modelo de Anthropic. Ve a Ajustes y"
" rellena los dos; puedes conseguir una clave en %(url)s."
msgstr ""
"You haven't set up your Anthropic key and model yet. Go to Settings and fill"
" in both; you can get a key at %(url)s."

#: cv_adaptativo/ia/anthropic.py:58
msgid ""
"Anthropic ha devuelto una respuesta vacía. Vuelve a generar la propuesta."
msgstr ""
"Anthropic returned an empty response. Try generating the proposal again."

#: cv_adaptativo/ia/anthropic.py:80
msgid ""
"Anthropic ha rechazado esta petición por motivos de seguridad. Revisa el "
"texto de la vacante o del CV e inténtalo de nuevo."
msgstr ""
"Anthropic declined this request for safety reasons. Check the job posting or"
" CV text and try again."

#: cv_adaptativo/ia/anthropic.py:88
msgid ""
"Anthropic ha devuelto una respuesta sin texto. Vuelve a generar la "
"propuesta."
msgstr ""
"Anthropic returned a response with no text. Try generating the proposal "
"again."

#: cv_adaptativo/ia/anthropic.py:100
msgid ""
"Falta la librería «anthropic». Instálala con: pip install -r "
"requirements.txt"
msgstr ""
"The \"anthropic\" library is missing. Install it with: pip install -r "
"requirements.txt"

#: cv_adaptativo/ia/anthropic.py:112
msgid "Tu clave de Anthropic no es válida o ha caducado. Revísala en Ajustes."
msgstr "Your Anthropic key isn't valid or has expired. Check it in Settings."

#: cv_adaptativo/ia/anthropic.py:114
#, python-format
msgid "El modelo configurado no existe en Anthropic. Revísalo en Ajustes."
msgstr "The model you set doesn't exist on Anthropic. Check it in Settings."

#: cv_adaptativo/ia/anthropic.py:117
msgid ""
"Has agotado la cuota de Anthropic por ahora. Espera un rato y vuelve a "
"intentarlo."
msgstr ""
"You've used up your Anthropic quota for now. Wait a while and try again."

#: cv_adaptativo/ia/anthropic.py:121
msgid ""
"No se ha podido contactar con Anthropic. Comprueba tu conexión a internet."
msgstr "Couldn't reach Anthropic. Check your internet connection."

#: cv_adaptativo/ia/anthropic.py:122
#, python-format
msgid "Anthropic ha devuelto un error: %(error)s"
msgstr "Anthropic returned an error: %(error)s"

#: cv_adaptativo/ia/groq.py:96
#, python-format
msgid ""
"Todavía no has configurado tu clave de Groq. Ve a Ajustes y pégala; puedes "
"conseguir una gratis en %(url)s."
msgstr ""
"You haven't set up your Groq key yet. Go to Settings and paste it in; you "
"can get a free one at %(url)s."

#: cv_adaptativo/ia/groq.py:104
msgid "Groq ha devuelto una respuesta vacía. Vuelve a generar la propuesta."
msgstr "Groq returned an empty response. Try generating the proposal again."

#: cv_adaptativo/ia/groq.py:130
msgid ""
"Groq ha devuelto una respuesta con un formato inesperado. Vuelve a generar "
"la propuesta."
msgstr ""
"Groq returned a response in an unexpected format. Try generating the "
"proposal again."

#: cv_adaptativo/ia/groq.py:142
msgid ""
"Falta la librería «groq». Instálala con: pip install -r requirements.txt"
msgstr ""
"The “groq” library is missing. Install it with: pip install -r "
"requirements.txt"

#: cv_adaptativo/ia/groq.py:159
#, python-format
msgid ""
"Tu clave de Groq no es válida o ha caducado. Revísala en Ajustes, puedes "
"generar una gratis en %(url)s."
msgstr ""
"Your Groq key is invalid or has expired. Check it in Settings; you can "
"generate a free one at %(url)s."

#: cv_adaptativo/ia/groq.py:165
msgid ""
"Esta petición es demasiado grande para el límite de tokens por minuto de tu "
"plan gratuito de Groq. Si es un CV, una vacante o un perfil muy largos, "
"prueba con un texto más corto."
msgstr ""
"This request is too large for the per-minute token limit on your free Groq "
"plan. If it's a very long CV, job posting or profile, try shorter text."

#: cv_adaptativo/ia/groq.py:171
msgid ""
"Has agotado la cuota gratuita de Groq por ahora. Espera un rato y vuelve a "
"intentarlo, o usa otra clave."
msgstr ""
"You've used up your free Groq quota for now. Wait a while and try again, or "
"use a different key."

#: cv_adaptativo/ia/groq.py:176
#, python-format
msgid ""
"El modelo «%(modelo)s» ya no está disponible en Groq. Elige otro en Ajustes."
msgstr ""
"The model “%(modelo)s” is no longer available on Groq. Choose another one in"
" Settings."

#: cv_adaptativo/ia/groq.py:182
msgid "Groq ha tardado demasiado en responder. Vuelve a generar la propuesta."
msgstr "Groq took too long to respond. Try generating the proposal again."

#: cv_adaptativo/ia/groq.py:186
msgid ""
"No se ha podido contactar con Groq. Comprueba tu conexión a internet y "
"vuelve a intentarlo."
msgstr "Could not reach Groq. Check your internet connection and try again."

#: cv_adaptativo/ia/groq.py:189
#, python-format
msgid "Groq ha devuelto un error: %(error)s"
msgstr "Groq returned an error: %(error)s"

#: cv_adaptativo/ia/openai_compatible.py:61
msgid ""
"Todavía no has configurado la URL base, la clave y el modelo de tu "
"proveedor. Ve a Ajustes y rellena los tres."
msgstr ""
"You haven't set up your provider's base URL, key, and model yet. Go to "
"Settings and fill in all three."

#: cv_adaptativo/ia/openai_compatible.py:68
msgid ""
"El proveedor ha devuelto una respuesta vacía. Vuelve a generar la propuesta."
msgstr ""
"The provider returned an empty response. Try generating the proposal again."

#: cv_adaptativo/ia/openai_compatible.py:93
msgid ""
"El proveedor ha devuelto una respuesta con un formato inesperado. Vuelve a "
"generar la propuesta."
msgstr ""
"The provider returned a response in an unexpected format. Try generating the"
" proposal again."

#: cv_adaptativo/ia/openai_compatible.py:105
msgid ""
"Falta la librería «openai». Instálala con: pip install -r requirements.txt"
msgstr ""
"The \"openai\" library is missing. Install it with: pip install -r "
"requirements.txt"

#: cv_adaptativo/ia/openai_compatible.py:122
msgid "Tu clave de API no es válida o ha caducado. Revísala en Ajustes."
msgstr "Your API key isn't valid or has expired. Check it in Settings."

#: cv_adaptativo/ia/openai_compatible.py:126
msgid ""
"El modelo configurado no existe en este proveedor, o la URL base de Ajustes "
"está mal. Revisa ambos."
msgstr ""
"The model you set doesn't exist for this provider, or the base URL in "
"Settings is wrong. Check both."

#: cv_adaptativo/ia/openai_compatible.py:131
msgid ""
"Has agotado la cuota de tu proveedor por ahora. Espera un rato y vuelve a "
"intentarlo."
msgstr ""
"You've used up your provider's quota for now. Wait a while and try again."

#: cv_adaptativo/ia/openai_compatible.py:136
msgid ""
"El proveedor ha tardado demasiado en responder. Vuelve a generar la "
"propuesta."
msgstr ""
"The provider took too long to respond. Try generating the proposal again."

#: cv_adaptativo/ia/openai_compatible.py:140
msgid ""
"No se ha podido contactar con la URL base configurada. Comprueba que esté "
"bien escrita y tu conexión a internet."
msgstr ""
"Couldn't reach the base URL you set. Check that it's typed correctly and "
"that you're connected to the internet."

#: cv_adaptativo/ia/openai_compatible.py:143
#, python-format
msgid "El proveedor ha devuelto un error: %(error)s"
msgstr "The provider returned an error: %(error)s"

#: cv_adaptativo/perfil/almacen.py:155
#, python-format
msgid ""
"«%(nombre)s» no está guardado en UTF-8, así que no se pueden leer sus "
"acentos. Vuelve a guardarlo con codificación UTF-8."
msgstr ""
"“%(nombre)s” is not saved as UTF-8, so accented characters can't be read. "
"Save it again using UTF-8 encoding."

#: cv_adaptativo/perfil/almacen.py:250
#, python-format
msgid "No se pudo borrar «%(nombre)s»: %(detalle)s."
msgstr "Could not delete “%(nombre)s”: %(detalle)s."

#: cv_adaptativo/perfil/almacen.py:273
#, python-format
msgid "No se pudo guardar «%(nombre)s»: %(detalle)s."
msgstr "Could not save “%(nombre)s”: %(detalle)s."

#: cv_adaptativo/perfil/almacen.py:295
#, python-format
msgid "No se pudo anotar «%(nombre)s»: %(detalle)s."
msgstr "Could not write to “%(nombre)s”: %(detalle)s."

#: cv_adaptativo/perfil/almacen.py:328
#, python-format
msgid ""
"«%(id)s» no sirve como identificador. Usa solo letras sin acentos, números, "
"guiones y puntos, por ejemplo «data-analyst-movilidad»."
msgstr ""
"“%(id)s” can't be used as an ID. Use only unaccented letters, numbers, "
"hyphens and dots, e.g. “data-analyst-mobility”."

#: cv_adaptativo/perfil/almacen.py:347
#, python-format
msgid ""
"Todavía no hay ningún perfil que exportar: la carpeta «%(raiz)s» no existe."
msgstr ""
"There's no profile to export yet: the folder “%(raiz)s” does not exist."

#: cv_adaptativo/perfil/almacen.py:370
#, python-format
msgid "No se pudo crear el respaldo: %(detalle)s."
msgstr "Could not create the backup: %(detalle)s."

#: cv_adaptativo/perfil/almacen.py:381
#, python-format
msgid "No se encuentra el fichero de respaldo «%(origen)s»."
msgstr "The backup file “%(origen)s” could not be found."

#: cv_adaptativo/perfil/almacen.py:386
#, python-format
msgid ""
"La carpeta «%(raiz)s» ya tiene un perfil dentro. Importa sobre una carpeta "
"vacía, o borra el perfil actual antes, para no acabar con una mezcla de los "
"dos."
msgstr ""
"The folder “%(raiz)s” already has a profile in it. Import into an empty "
"folder, or delete the current profile first, so the two don't end up mixed "
"together."

#: cv_adaptativo/perfil/almacen.py:401
#, python-format
msgid "«%(nombre)s» no es un respaldo válido: no se puede abrir como zip."
msgstr "“%(nombre)s” is not a valid backup: it can't be opened as a zip file."

#: cv_adaptativo/perfil/almacen.py:407
#, python-format
msgid "No se pudo restaurar el respaldo: %(detalle)s."
msgstr "Could not restore the backup: %(detalle)s."

#: cv_adaptativo/perfil/almacen.py:418
#, python-format
msgid ""
"«%(nombre)s» contiene rutas que salen de la carpeta del perfil "
"(«%(miembro)s»). No se ha importado nada."
msgstr ""
"“%(nombre)s” contains paths that fall outside the profile folder "
"(“%(miembro)s”). Nothing was imported."

#: cv_adaptativo/perfil/extraccion.py:40
msgid ""
"Falta la librería «pypdf». Instálala con: pip install -r requirements.txt"
msgstr ""
"The “pypdf” library is missing. Install it with: pip install -r "
"requirements.txt"

#: cv_adaptativo/perfil/extraccion.py:48
msgid "No se ha podido leer el PDF: parece estar dañado o protegido."
msgstr "The PDF could not be read: it looks damaged or password-protected."

#: cv_adaptativo/perfil/extraccion.py:57
msgid ""
"Falta la librería «python-docx». Instálala con: pip install -r "
"requirements.txt"
msgstr ""
"The “python-docx” library is missing. Install it with: pip install -r "
"requirements.txt"

#: cv_adaptativo/perfil/extraccion.py:64
msgid "No se ha podido leer el documento: ¿es un .docx válido?"
msgstr "The document could not be read: is it a valid .docx file?"

#: cv_adaptativo/perfil/extraccion.py:100
#, python-format
msgid "«%(nombre)s» no es un formato soportado. Admitidos: %(formatos)s."
msgstr ""
"“%(nombre)s” is not a supported format. Supported formats: %(formatos)s."

#: cv_adaptativo/perfil/extraccion.py:113
#, python-format
msgid ""
"No se ha podido leer «%(nombre)s». Puede estar dañado, protegido con "
"contraseña, o en una variante del formato que esta versión no reconoce. Si "
"puedes, pega el texto a mano en su lugar."
msgstr ""
"“%(nombre)s” could not be read. It may be damaged, password-protected, or in"
" a format variant this version doesn't recognise. If you can, paste the text"
" in by hand instead."

#: cv_adaptativo/perfil/extraccion.py:123
#, python-format
msgid ""
"No se ha podido sacar texto de «%(nombre)s». Si es un PDF escaneado (una "
"imagen, no texto real), pega el contenido a mano."
msgstr ""
"No text could be extracted from “%(nombre)s”. If it's a scanned PDF (an "
"image, not real text), paste the content in by hand."

#: cv_adaptativo/perfil/keywords.py:90
msgid "No hay ninguna clave de API configurada. Ve a Ajustes."
msgstr "No API key is set up. Go to Settings."

#: cv_adaptativo/perfil/keywords.py:99
msgid "No se pudo contactar con el proveedor de IA."
msgstr "Could not reach the AI provider."

#: cv_adaptativo/perfil/keywords.py:103
msgid "El modelo no ha devuelto ninguna keyword aprovechable."
msgstr "The model didn't return any usable keywords."

#: cv_adaptativo/perfil/serializacion.py:49
#, python-format
msgid ""
"«%(origen)s» no tiene el formato esperado: se esperaba una lista de campos "
"como «titulo:» o «keywords:»."
msgstr ""
"“%(origen)s” is not in the expected format: a list of fields such as "
"“titulo:” or “keywords:” was expected."

#: cv_adaptativo/perfil/serializacion.py:78
#, python-format
msgid ""
"«%(origen)s» tiene un error de formato en la línea %(linea)s. Suele ser un "
"espacio de más al principio de una línea, o un texto con «:» sin comillas."
msgstr ""
"“%(origen)s” has a formatting error on line %(linea)s. This is usually an "
"extra space at the start of a line, or text containing “:” without quotes."

#: cv_adaptativo/perfil/serializacion.py:85
#, python-format
msgid ""
"«%(origen)s» tiene un error de formato. Suele ser un espacio de más al "
"principio de una línea, o un texto con «:» sin comillas."
msgstr ""
"“%(origen)s” has a formatting error. This is usually an extra space at the "
"start of a line, or text containing “:” without quotes."

#: cv_adaptativo/perfil/serializacion.py:194
#, python-format
msgid ""
"En «%(origen)s», el campo «%(campo)s» es una lista y debería ser un texto, o"
" «es:» y «en:» con un texto cada uno."
msgstr ""
"In “%(origen)s”, the field “%(campo)s” is a list and should be plain text, "
"or “es:” and “en:” each with their own text."

#: cv_adaptativo/perfil/serializacion.py:226
#, python-format
msgid ""
"En «%(origen)s», el campo «%(campo)s»%(sufijo)s debería ser una lista: una "
"línea por elemento, cada una empezando por «- »."
msgstr ""
"In “%(origen)s”, the field “%(campo)s”%(sufijo)s should be a list: one line "
"per item, each starting with “- ”."

#: cv_adaptativo/perfil/validacion.py:42
msgid "español"
msgstr "Spanish"

#: cv_adaptativo/perfil/validacion.py:42
msgid "inglés"
msgstr "English"

#: cv_adaptativo/perfil/validacion.py:52
#, python-format
msgid "Experiencia «%(id)s»"
msgstr "Experience “%(id)s”"

#: cv_adaptativo/perfil/validacion.py:52
msgid "Una experiencia"
msgstr "An experience"

#: cv_adaptativo/perfil/validacion.py:59
msgid ""
"Hay una experiencia sin identificador. El identificador es el nombre del "
"fichero, por ejemplo «data-analyst-movilidad.yaml»."
msgstr ""
"There's an experience entry with no ID. The ID is the file name, e.g. “data-"
"analyst-mobility.yaml”."

#: cv_adaptativo/perfil/validacion.py:67
#, python-format
msgid "%(etiqueta)s: falta el título en %(nombre)s."
msgstr "%(etiqueta)s: missing the title in %(nombre)s."

#: cv_adaptativo/perfil/validacion.py:71
#, python-format
msgid ""
"%(etiqueta)s: falta el periodo en %(nombre)s (por ejemplo «2025 - "
"ACTUALIDAD»)."
msgstr ""
"%(etiqueta)s: missing the period in %(nombre)s (e.g. “2025 - PRESENT”)."

#: cv_adaptativo/perfil/validacion.py:78
#, python-format
msgid ""
"%(etiqueta)s: falta el stack en %(nombre)s (las tecnologías que usaste)."
msgstr ""
"%(etiqueta)s: missing the tech stack in %(nombre)s (the technologies you "
"used)."

#: cv_adaptativo/perfil/validacion.py:87
#, python-format
msgid ""
"%(etiqueta)s: no tiene palabras clave, así que casi nunca se elegirá para un"
" CV. Añade los términos con los que la buscaría una empresa."
msgstr ""
"%(etiqueta)s: has no keywords, so it will almost never be picked for a CV. "
"Add the terms a company would use to look for it."

#: cv_adaptativo/perfil/validacion.py:97
#, python-format
msgid "%(etiqueta)s: no tiene ningún punto en %(nombre)s."
msgstr "%(etiqueta)s: has no bullet points in %(nombre)s."

#: cv_adaptativo/perfil/validacion.py:101
#, python-format
msgid ""
"%(etiqueta)s: hay algún punto vacío en %(nombre)s; escríbelo o quítalo."
msgstr ""
"%(etiqueta)s: there's an empty bullet point in %(nombre)s; write it in or "
"remove it."

#: cv_adaptativo/perfil/validacion.py:111
#, python-format
msgid "Skill «%(id)s»"
msgstr "Skill “%(id)s”"

#: cv_adaptativo/perfil/validacion.py:111
msgid "Una skill"
msgstr "A skill"

#: cv_adaptativo/perfil/validacion.py:117
msgid ""
"Hay una skill sin identificador. El identificador es el nombre del fichero, "
"por ejemplo «python.yaml»."
msgstr ""
"There's a skill with no ID. The ID is the file name, e.g. “python.yaml”."

#: cv_adaptativo/perfil/validacion.py:124
#: cv_adaptativo/perfil/validacion.py:161
#: cv_adaptativo/perfil/validacion.py:191
#, python-format
msgid "%(etiqueta)s: falta el nombre en %(nombre)s."
msgstr "%(etiqueta)s: missing the name in %(nombre)s."

#: cv_adaptativo/perfil/validacion.py:129
#, python-format
msgid ""
"%(etiqueta)s: no tiene categoría. Se usa para agrupar las skills del CV y "
"para repartirlas en el «Sobre mí»."
msgstr ""
"%(etiqueta)s: has no category. It's used to group the skills on the CV and "
"to spread them across “About me”."

#: cv_adaptativo/perfil/validacion.py:137
#, python-format
msgid ""
"%(etiqueta)s: no tiene palabras clave, así que casi nunca se elegirá para un"
" CV. Añade cómo la nombran las ofertas."
msgstr ""
"%(etiqueta)s: has no keywords, so it will almost never be picked for a CV. "
"Add how job postings refer to it."

#: cv_adaptativo/perfil/validacion.py:148
#, python-format
msgid "Skill personal «%(id)s»"
msgstr "Personal skill “%(id)s”"

#: cv_adaptativo/perfil/validacion.py:148
msgid "Una skill personal"
msgstr "A personal skill"

#: cv_adaptativo/perfil/validacion.py:154
msgid ""
"Hay una skill personal sin identificador. El identificador es el nombre del "
"fichero, por ejemplo «trabajo-en-equipo.yaml»."
msgstr ""
"There's a personal skill with no ID. The ID is the file name, e.g. "
"“teamwork.yaml”."

#: cv_adaptativo/perfil/validacion.py:166
#, python-format
msgid ""
"%(etiqueta)s: no tiene palabras clave, así que puede que una vacante la siga"
" marcando como hueco aunque ya la tengas. Añade cómo se nombra en las "
"ofertas."
msgstr ""
"%(etiqueta)s: has no keywords, so a job posting might still flag it as a gap"
" even though you already have it. Add how it's named in job postings."

#: cv_adaptativo/perfil/validacion.py:178
#, python-format
msgid "Idioma «%(id)s»"
msgstr "Language “%(id)s”"

#: cv_adaptativo/perfil/validacion.py:178
msgid "Un idioma"
msgstr "A language"

#: cv_adaptativo/perfil/validacion.py:184
msgid ""
"Hay un idioma sin identificador. El identificador es el nombre del fichero, "
"por ejemplo «ingles.yaml»."
msgstr ""
"There's a language with no ID. The ID is the file name, e.g. “english.yaml”."

#: cv_adaptativo/perfil/validacion.py:195
#, python-format
msgid ""
"%(etiqueta)s: falta el nivel en %(nombre)s (por ejemplo «C1 — Avanzado»)."
msgstr "%(etiqueta)s: missing the level in %(nombre)s (e.g. “C1 — Advanced”)."

#: cv_adaptativo/perfil/validacion.py:202
#, python-format
msgid ""
"%(etiqueta)s: no tiene palabras clave, así que puede que una vacante lo siga"
" marcando como hueco aunque ya lo tengas. Añade cómo se nombra en las "
"ofertas (p. ej. «advanced english», «fluido»)."
msgstr ""
"%(etiqueta)s: has no keywords, so a job posting might still flag it as a gap"
" even though you already have it. Add how it's named in job postings (e.g. "
"“advanced English”, “fluent”)."

#: cv_adaptativo/perfil/validacion.py:220
#, python-format
msgid "El «Sobre mí» está vacío en %(nombre)s."
msgstr "“About me” is empty in %(nombre)s."

#: cv_adaptativo/perfil/validacion.py:227
#, python-format
msgid ""
"Al «Sobre mí» en %(nombre)s le faltan estos huecos: %(huecos)s. Escríbelos "
"tal cual donde quieras que entren las skills elegidas."
msgstr ""
"“About me” in %(nombre)s is missing these placeholders: %(huecos)s. Write "
"them exactly as shown, wherever you want the chosen skills to go."

#: cv_adaptativo/perfil/validacion.py:238
#, python-format
msgid ""
"El «Sobre mí» en %(nombre)s tiene huecos que el sistema no sabe rellenar: "
"%(desconocidos)s. Los válidos son: %(validos)s."
msgstr ""
"“About me” in %(nombre)s has placeholders the system doesn't know how to "
